# =============================================================================
# Routely × Островок — шаблон переменных окружения
#
#   cp .env.example .env
#
# Docker Compose читает .env из корня репозитория автоматически.
# Файл .env в git не попадает — реальные ключи коммитить нельзя.
# Все значения ниже — локальные демо-значения, не для продакшена.
# =============================================================================

# ---- LLM (любой OpenAI-совместимый API) ----
# Ключ можно положить в ЛЮБУЮ из двух переменных: LLM_API_KEY (приоритет)
# или OPENAI_API_KEY. Без ключа система работает в мок-режиме.
LLM_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.aitunnel.ru/v1
LLM_MODEL=deepseek-chat
# Таймаут одного запроса к LLM, секунды. Без него зависший провайдер держит
# запрос до 10 минут, и ответ отельера не доходит до БД.
LLM_TIMEOUT_S=20
# 1 — LLM не вызывается, ответы детерминированные (демо без ключа)
# 0 — реальные вызовы LLM
USE_MOCK_LLM=1

# ---- PostgreSQL ----
# Если меняете POSTGRES_*, поменяйте и DATABASE_URL ниже.
POSTGRES_USER=routely
POSTGRES_PASSWORD=routely
POSTGRES_DB=routely
DATABASE_URL=postgresql+asyncpg://routely:routely@db:5432/routely

# ---- Приложение ----
# Внешний порт, на котором открывается UI: http://localhost:8080
APP_PORT=8080

# ---- Геоданные (пути внутри контейнера, том ./data:/data) ----
# Пути заданы явно, хотя у config.py есть те же значения по умолчанию:
# дефолт вычисляется от корня кода, и в контейнере он совпадает с /data
# случайно. Явное значение — это контракт, а не совпадение.
DEM_PATH=/data/dem.tif
BUILDINGS_PATH=/data/buildings.gpkg
NOISE_PATH=/data/noise_sources.geojson
BEACHES_PATH=/data/beaches.geojson
HOTELS_PATH=/data/hotels.geojson

# ---- Замер качества (make eval) ----
# Разметка лежит в репозитории, отчёт генерируется и в git не попадает.
GROUND_TRUTH=/data/ground_truth.csv
EVAL_REPORT=/data/eval_report.json
# Адрес API задаёт docker-compose (http://backend:8000 внутри сети).
# Переопределять его в .env нужно только при запуске скрипта вне Docker.
