# =============================================================================
# Переменные демо-стенда (deploy/demo).
#
#   cp .env.example .env
#
# Этот файл читает docker compose из папки deploy/demo. Корневой .env
# тоже подхватывается (см. x-env-file в docker-compose.yml), поэтому
# ключи LLM достаточно держать в одном месте — в корне репозитория.
# Значения из ЭТОГО файла имеют приоритет над корневыми.
# =============================================================================

# ---- Публикация наружу ----
# Хост и порт, на которые смотрит системный nginx.
# 127.0.0.1 — порт виден только с самого сервера, из интернета недоступен.
# Меняй порт, если 8081 тоже занят: ss -ltnp | grep -E ':(8081)\b'
DEMO_BIND_HOST=127.0.0.1
DEMO_BIND_PORT=8081

# ---- LLM ----
# Без ключа работает мок-режим (USE_MOCK_LLM=1 по умолчанию) — для демо
# этого достаточно. С ключом разбор запросов и ответов отельера идёт через
# реальную модель; провайдер должен быть OpenAI-совместимым.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.aitunnel.ru/v1
# LLM_MODEL=deepseek-chat
# LLM_TIMEOUT_S=20
# USE_MOCK_LLM=1

# ---- PostgreSQL ----
# ВНИМАНИЕ: если том ostrovok_pgdata уже создан с другими учётными данными,
# смена пароля здесь приведёт к отказу подключения (пароль задаётся только
# при инициализации тома). Варианты: оставить прежние значения, либо
# пересоздать том (docker volume rm ostrovok_pgdata) и прогреть данные заново.
# Если меняешь POSTGRES_*, поменяй и DATABASE_URL.
# POSTGRES_USER=routely
# POSTGRES_PASSWORD=routely
# POSTGRES_DB=routely
# DATABASE_URL=postgresql+asyncpg://routely:routely@db:5432/routely
