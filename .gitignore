# ================= Секреты и локальная конфигурация =================
# Файлы окружения содержат секреты (ключи API, пароли БД) — их нельзя коммитить.
# Шаблон .env.example (без секретов) следует хранить в репозитории.
.env
.env.local
.env.*.local

# ================= Python =================
# Виртуальное окружение
.venv/
venv/
env/
.ENV/

# Кэши и байт-код
__pycache__/
*.py[cod]
*$py.class
*.so

# Инструменты тестирования и анализа
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# ================= Node / Frontend =================
node_modules/
.next/
out/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Сборки
dist/
build/

# ================= Данные =================
# Папка data/ заполняется скриптами (scripts/fetch_data.py) и содержит
# большие геофайлы (dem.tif, buildings.gpkg) и кэши — не для git.
# Файл seed.sql исключение: он монтируется в контейнер PostgreSQL.
# Стало (seed.sql останется в git):
/data/*
!/data/seed.sql


# ================= Артефакты и резервные копии =================
.tools/
workspace*.tar
*.log

# ================= IDE / ОС =================
.idea/
.vscode/
.DS_Store
Thumbs.db

